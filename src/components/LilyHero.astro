---
// Full-screen hero: the red spider lily gathers from particles, shies away from the pointer
// and scatters as you scroll. It stays dark in both night and day, like a photograph would.
import lily from './lily-paths.svg.txt?raw';
---
<section class="hero" id="hero">
  <canvas id="bloom" aria-hidden="true"></canvas>
  <div class="lily-src" set:html={lily}></div>
  <p class="cap meta">Red spider lily · particles</p>
  <a class="scroll meta" href="#links"><i></i>Scroll</a>
</section>

<style>
  .hero { position: relative; height: 100vh; min-height: 560px; background: #12100d; overflow: hidden; }
  #bloom { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; }
  .lily-src { display: none; }
  .scroll, .cap { position: absolute; bottom: 26px; margin: 0; color: rgba(238, 233, 223, 0.6); letter-spacing: 0.2em; text-transform: uppercase; text-decoration: none; }
  .scroll { left: clamp(20px, 5vw, 72px); display: flex; align-items: center; gap: 10px; }
  .scroll i { width: 5px; height: 5px; border-radius: 50%; background: #c4554a; animation: pulse 2s ease-in-out infinite; }
  .cap { right: clamp(20px, 5vw, 72px); }
  @keyframes pulse { 50% { opacity: 0.3; } }
  @media (max-width: 640px) { .cap { display: none; } }
</style>

<script is:inline>
(function () {
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var hero = document.getElementById('hero'), cv = document.getElementById('bloom'), ctx = cv.getContext('2d');
  var src = hero.querySelector('.lily-src svg');
  var W, H, dpr, parts = [], stars = [], mouse = { x: -1e4, y: -1e4 }, t0 = performance.now(), heroP = 0, running = true;

  // trace the line-drawn lily into points: draw it big off-screen and keep lit pixels on a grid
  function sample() {
    var vb = [10, 0, 280, 430], S = 3, oc = document.createElement('canvas'), o = oc.getContext('2d');
    oc.width = vb[2] * S; oc.height = vb[3] * S; o.scale(S, S); o.translate(-vb[0], -vb[1]);
    o.lineCap = 'round'; o.strokeStyle = '#fff'; o.fillStyle = '#fff';
    src.querySelectorAll('path').forEach(function (p) { o.lineWidth = p.classList.contains('stem') ? 3 : 2.7; o.stroke(new Path2D(p.getAttribute('d'))); });
    src.querySelectorAll('circle').forEach(function (c) { o.beginPath(); o.arc(+c.getAttribute('cx'), +c.getAttribute('cy'), 3.4, 0, 7); o.fill(); });
    var d = o.getImageData(0, 0, oc.width, oc.height).data, pts = [], step = 3.5;
    for (var y = 0; y < oc.height; y += step) for (var x = 0; x < oc.width; x += step)
      if (d[(Math.round(y) * oc.width + Math.round(x)) * 4 + 3] > 120) pts.push([x / S + vb[0], y / S + vb[1], y / oc.height]);
    return pts;
  }
  var PTS = sample();
  function rng(a) { return function () { a = (a * 16807) % 2147483647; return a / 2147483647; }; }

  function layout() {
    dpr = Math.min(devicePixelRatio || 1, 2); W = cv.clientWidth; H = cv.clientHeight; cv.width = W * dpr; cv.height = H * dpr;
    var h = Math.min(H * 0.78, W * 1.15), sc = h / 430, ox = W / 2 - 150 * sc, oy = H * 0.12, r = rng(7);
    parts = PTS.map(function (p, i) {
      var old = parts[i], tone = r();
      return {
        hx: ox + p[0] * sc, hy: oy + p[1] * sc,
        x: old ? old.x : r() * W, y: old ? old.y : r() * H, vx: 0, vy: 0,
        c: tone < 0.12 ? '#f3ece4' : tone < 0.3 ? '#ff7a6e' : '#c9483d',
        s: (p[2] > 0.42 ? 1.6 : 2.1) * (0.8 + r() * 0.5), delay: r() * 900 + (1 - p[2]) * 300,
        tw: r() * 6.283, sx: (r() - 0.5) * 2, sy: -r()
      };
    });
    stars = []; for (var k = 0; k < Math.round(W * H / 5200); k++) stars.push({ x: r() * W, y: r() * H, s: r() * 1.3 + 0.3, tw: r() * 6.283, v: 0.4 + r() * 1.4 });
  }

  function frame(now) {
    requestAnimationFrame(frame);
    if (!running) return;
    var t = now - t0;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H);
    var sa = reduce ? 1 : Math.min(1, Math.max(0, (t - 300) / 1400)) * (1 - heroP * 0.6);
    ctx.fillStyle = '#eee9df';
    stars.forEach(function (s) { ctx.globalAlpha = sa * (0.25 + 0.35 * Math.pow(Math.sin(t / 900 * s.v + s.tw), 2)); ctx.fillRect(s.x, s.y - heroP * 60 * s.v, s.s, s.s); });
    var R = 90, fade = 1 - Math.max(0, heroP - 0.35) / 0.65;
    parts.forEach(function (p) {
      var go = reduce ? 1 : Math.min(1, Math.max(0, (t - 500 - p.delay) / 1200)), e = 1 - Math.pow(1 - go, 3);
      var tx = p.hx + p.sx * heroP * 220, ty = p.hy + (p.sy * 260 - 80) * heroP;
      if (!reduce) {
        var dx = p.x - mouse.x, dy = p.y - mouse.y, d2 = dx * dx + dy * dy;
        if (d2 < R * R && go >= 1) { var d = Math.sqrt(d2) || 1, f = (1 - d / R) * 2.2; p.vx += dx / d * f - dy / d * f * 0.6; p.vy += dy / d * f + dx / d * f * 0.6; }
        var k = go > 0 ? 0.012 + 0.07 * e : 0; p.vx += (tx - p.x) * k; p.vy += (ty - p.y) * k;
        p.vx *= 0.82; p.vy *= 0.82; p.x += p.vx; p.y += p.vy;
        if (go <= 0) { p.x += Math.sin(t / 900 + p.tw) * 0.15; p.y -= 0.08; }
      } else { p.x = tx; p.y = ty; }
      ctx.globalAlpha = Math.max(0, (0.25 + 0.75 * e) * fade * (0.75 + 0.25 * Math.sin(t / 500 + p.tw)));
      ctx.fillStyle = p.c; ctx.fillRect(p.x, p.y, p.s, p.s);
    });
    ctx.globalAlpha = 1;
  }

  function onScroll() { heroP = Math.max(0, Math.min(1, scrollY / (hero.offsetHeight * 0.9))); running = scrollY < hero.offsetHeight; }
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('pointermove', function (e) { var r = cv.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; }, { passive: true });
  document.addEventListener('pointerout', function (e) { if (!e.relatedTarget) { mouse.x = mouse.y = -1e4; } });
  var rt; addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(layout, 120); });
  layout(); onScroll(); requestAnimationFrame(frame);
})();
</script>
