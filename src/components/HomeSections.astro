---
// Everything below the hero on the home page, shared by the lily and photo landing options.
import { links, experience, design } from '../data/site.js';
const base = import.meta.env.BASE_URL;
const href = (h) => (!h ? null : /^(https?:|mailto:)/.test(h) ? h : base + h);
const projects = Object.values(import.meta.glob('../pages/projects/*.md', { eager: true }))
  .map((p) => ({ ...p.frontmatter, url: p.url }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
const icon = { github: '<>', linkedin: 'in', comply: 'c.', email: '@', resume: '¶' };
---
  <main class="wrap">
    <section class="sec" id="links">
      <div class="sec-h"><span class="label">Links &amp; contact</span></div>
      <ul class="rows links">
        {links.map((l) => (
          <li>
            <a class="row" href={href(l.href)} target={/^https?:/.test(l.href) ? '_blank' : undefined} rel="noopener">
              <span class="ic" aria-hidden="true">{icon[l.k]}</span>
              <span class="meta" style="text-transform:uppercase;letter-spacing:.16em">{l.label}</span>
              <span class="t">{l.value}</span>
              <span class="arr" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="sec">
      <div class="sec-h"><span class="label">Projects</span><a class="more" href={base + 'projects/'}>All {projects.length} →</a></div>
      <ul class="rows">
        {projects.slice(0, 8).map((p) => (
          <li>
            <a class="row" href={p.url}>
              <span class="meta">{p.date.slice(0, 4)}</span>
              <span class="t">{p.title}</span>
              <span class="r">{p.org}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="sec">
      <div class="sec-h"><span class="label">Experience</span><a class="more" href={base + 'profile/'}>Full profile →</a></div>
      <ul class="rows">
        {experience.map((e) => (
          <li>
            <a class="row" href={base + 'profile/'}>
              <span class="meta">{e.when}</span>
              <span class="t">{e.role}</span>
              <span class="r">{e.org.split(' · ')[0]}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="sec">
      <div class="sec-h"><span class="label">Digital design</span><a class="more" href={base + 'design/'}>All design →</a></div>
      <div class="tiles">
        {design.slice(0, 4).map((d) => <a class="tile" href={base + 'design/'} style="text-decoration:none"><span><b>{d.n}</b>Your design work</span></a>)}
      </div>
    </section>
  </main>

<style is:global>
  main .rows:not(.links) .row { grid-template-columns: 130px minmax(0, 1fr) auto; }
  @media (max-width: 640px) { main .rows:not(.links) .row { grid-template-columns: 1fr; } }
</style>
