---
// One project: kind · where, title, summary, period and tags, links and the result,
// then the write-up with a sticky Contents list that marks the section you're reading.
import Base from './Base.astro';
const { frontmatter: f, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const base = import.meta.env.BASE_URL;
---
<Base title={f.title + ' · Sidanta Parajuli'} description={f.summary} active="projects">
  <main class="wrap post">
    <article>
      <header class="ph">
        <p class="label kind">{f.kind} · {f.org}{f.draft && <span class="draft">Draft</span>}</p>
        <h1>{f.title}</h1>
        <p class="sum">{f.summary}</p>
        <div class="pm meta"><span>{f.period}</span><span class="tg">{f.tags.map((t) => <span>#{t.replace(/ /g, '-')}</span>)}</span></div>
        {(f.impact || (f.links && f.links.length > 0)) && (
          <div class="facts">
            {f.impact && <p><span class="label">Result</span><span>{f.impact}</span></p>}
            {f.links && f.links.length > 0 && <p><span class="label">See it</span><span class="ls">{f.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.t} ↗</a>)}</span></p>}
          </div>
        )}
      </header>
      <div class="body"><slot /></div>
      <p class="back"><a class="more" href={base + 'projects/'}>← All projects</a></p>
    </article>
    {toc.length > 1 && (
      <aside class="toc" aria-label="Contents">
        <p class="meta" style="text-transform:uppercase;letter-spacing:.18em">Contents</p>
        <ol>{toc.map((h) => <li><a href={'#' + h.slug}>{h.text}</a></li>)}</ol>
      </aside>
    )}
  </main>
</Base>

<style>
  .post { display: grid; grid-template-columns: minmax(0, 660px) 200px; gap: 70px; justify-content: space-between; padding-top: 64px; }
  .kind { font-size: 0.86rem; letter-spacing: 0.22em; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .draft { font: 400 0.6rem var(--mono); letter-spacing: 0.14em; color: var(--lily); border: 1px solid var(--lily); padding: 2px 7px; }
  .ph h1 { font-size: clamp(2rem, 4.4vw, 2.9rem); line-height: 1.12; margin: 14px 0 22px; }
  .sum { color: var(--soft); max-width: 50ch; font-family: var(--serif); font-weight: 300; font-size: 1.1rem; line-height: 1.6; margin: 0 0 22px; }
  .pm { display: flex; justify-content: space-between; gap: 8px 20px; flex-wrap: wrap; padding-bottom: 18px; }
  .tg { display: flex; gap: 14px; flex-wrap: wrap; text-transform: uppercase; }
  .facts { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 4px 0; }
  .facts p { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 16px; margin: 0; padding: 10px 0; align-items: baseline; }
  .facts p + p { border-top: 1px solid var(--line); }
  .ls { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .ls a { font: 400 0.72rem var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); text-decoration: none; }
  .ls a:hover { text-decoration: underline; }
  .ph { padding-bottom: 8px; border-bottom: 1px solid var(--line); }
  .ph:has(.facts) { border-bottom: 0; }
  .body :global(h2) { font-size: 1.45rem; margin: 42px 0 14px; scroll-margin-top: 24px; }
  .body :global(p), .body :global(li) { color: color-mix(in srgb, var(--ink) 88%, var(--soft)); }
  .body :global(strong) { color: var(--ink); font-weight: 500; }
  .body :global(a) { color: var(--accent); text-underline-offset: 3px; }
  .body :global(figure) { margin: 34px 0; position: relative; z-index: 2; }
  .body :global(figure img) { border: 1px solid var(--line); width: 100%; cursor: zoom-in; }
  /* figures break out across the Contents column so diagrams stay readable */
  @media (min-width: 901px) { .body :global(figure) { margin-right: -270px; } }
  .body :global(figcaption) { font: 400 0.7rem/1.6 var(--mono); letter-spacing: 0.08em; color: var(--faint); margin-top: 10px; text-transform: uppercase; }
  .body :global(table) { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 0.94rem; }
  .body :global(th), .body :global(td) { text-align: left; vertical-align: top; padding: 10px 14px 10px 0; border-bottom: 1px solid var(--line); }
  .body :global(th) { font: 400 0.68rem var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); border-bottom-color: var(--line2); }
  .body :global(td:first-child) { color: var(--ink); white-space: nowrap; }
  .body :global(td) { color: var(--soft); }
  .body :global(thead:has(th:empty)) { display: none; }
  @media (max-width: 640px) { .body :global(td:first-child) { white-space: normal; } }
  .body :global(code) { font: 400 0.85em var(--mono); background: var(--paper); padding: 1px 5px; }
  .body :global(blockquote) { margin: 24px 0; padding-left: 16px; border-left: 2px solid var(--accent); font-family: var(--serif); font-style: italic; font-weight: 300; }
  .back { margin-top: 48px; }
  .toc { position: sticky; top: 30px; align-self: start; padding-top: 6px; }
  .toc ol { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 10px; }
  .toc a { display: grid; grid-template-columns: 18px 1fr; gap: 10px; font: 400 0.72rem/1.45 var(--mono); color: var(--faint); text-decoration: none; transition: color 0.2s; }
  .toc a::before { content: ''; height: 1px; background: currentColor; margin-top: 0.7em; transition: width 0.2s; width: 12px; }
  .toc a.on { color: var(--accent); }
  .toc a.on::before { width: 18px; }
  @media (max-width: 900px) { .post { grid-template-columns: minmax(0, 1fr); } .toc { display: none; } }
  @media (max-width: 520px) { .facts p { grid-template-columns: 1fr; gap: 4px; } }
</style>

<script is:inline>
(function () {
  // click a figure to open it full size
  document.querySelectorAll('.body figure img').forEach(function (img) {
    img.title = 'Open full size';
    img.addEventListener('click', function () { window.open(img.src, '_blank', 'noopener'); });
  });
  var links = [].slice.call(document.querySelectorAll('.toc a')); if (!links.length) return;
  var heads = links.map(function (a) { return document.getElementById(decodeURIComponent(a.hash.slice(1))); });
  function update() {
    var cur = 0; heads.forEach(function (h, i) { if (h && h.getBoundingClientRect().top < innerHeight * 0.3) cur = i; });
    links.forEach(function (a, i) { a.classList.toggle('on', i === cur); });
  }
  addEventListener('scroll', update, { passive: true }); update();
})();
</script>
