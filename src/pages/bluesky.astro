---
// Landing-page option: Blue sky. Same page as the home page, with this photograph as the hero
// and the color theme taken from it.
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import HomeSections from '../components/HomeSections.astro';
---
<Base title="Sidanta Parajuli" active="home" overHero={true} theme="bluesky">
  <PhotoHero name="bluesky" alt="A long Himalayan range under a clear deep-blue sky, with pine forest in the foreground" focus="32% 72%" />
  <HomeSections />
</Base>
