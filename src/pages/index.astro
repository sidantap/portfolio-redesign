---
import Base from '../layouts/Base.astro';
import LilyHero from '../components/LilyHero.astro';
import { links, work, design } from '../data/site.js';
const base = import.meta.env.BASE_URL;
const href = (h) => (!h ? null : /^(https?:|mailto:)/.test(h) ? h : base + h);
const posts = Object.values(import.meta.glob('./writing/*.md', { eager: true }))
  .map((p) => ({ ...p.frontmatter, url: p.url }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
const icon = { github: '<>', linkedin: 'in', comply: 'c.', email: '@', resume: '¶' };
---
<Base title="Sidanta Parajuli" active="home" overHero={true}>
  <LilyHero />

  <main class="wrap">
    <section class="sec" id="links">
      <div class="sec-h"><span class="label">Links &amp; contact</span></div>
      <ul class="rows links">
        {links.map((l) => (
          <li>
            <a class="row" href={href(l.href)} target={/^https?:/.test(l.href) ? '_blank' : undefined} rel="noopener">
              <span class="ic" aria-hidden="true">{icon[l.k]}</span>
              <span class="meta" style="text-transform:uppercase;letter-spacing:.16em">{l.label}</span>
              <span class="t">{l.value}</span>
              <span class="arr" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="sec">
      <div class="sec-h"><span class="label">Work &amp; projects</span><a class="more" href={base + 'profile/#work'}>All work →</a></div>
      <ul class="rows">
        {work.map((w) => {
          const Tag = w.href ? 'a' : 'div';
          return (
            <li>
              <Tag class="row" href={w.href} target={w.href ? '_blank' : undefined} rel="noopener">
                <span class="meta">{w.year}</span>
                <span class="t">{w.title}{w.href && <span class="arr" aria-hidden="true">↗</span>}</span>
                <span class="r">{w.where}</span>
              </Tag>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="sec">
      <div class="sec-h"><span class="label">Notes</span><a class="more" href={base + 'writing/'}>All {posts.length} →</a></div>
      <ul class="rows">
        {posts.map((p) => (
          <li>
            <a class="row" href={p.url}>
              <span class="meta">{p.date}</span>
              <span class="t">{p.title}</span>
              <span class="meta">{p.minutes} min</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="sec">
      <div class="sec-h"><span class="label">Digital design</span><a class="more" href={base + 'design/'}>All design →</a></div>
      <div class="tiles">
        {design.slice(0, 4).map((d) => <a class="tile" href={base + 'design/'} style="text-decoration:none"><span><b>{d.n}</b>Your design work</span></a>)}
      </div>
    </section>
  </main>
</Base>
