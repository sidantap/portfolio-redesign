---
import Base from '../../layouts/Base.astro';
const posts = Object.values(import.meta.glob('./*.md', { eager: true }))
  .map((p) => ({ ...p.frontmatter, url: p.url }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
const tagCount = {};
posts.forEach((p) => p.tags.forEach((t) => (tagCount[t] = (tagCount[t] || 0) + 1)));
const tags = Object.keys(tagCount).sort();
const years = [...new Set(posts.map((p) => p.date.slice(0, 4)))];
---
<Base title="Writing · Sidanta Parajuli" active="writing">
  <main class="wrap" style="padding-top:56px">
    <div class="bar">
      <label class="search"><span aria-hidden="true">/</span><input id="q" type="search" placeholder="search titles & tags" aria-label="Search titles and tags" /></label>
      <span class="meta" id="count">{posts.length} / {posts.length}</span>
    </div>
    <div class="tagrow" id="tags">
      <button type="button" class="tf on" data-t="">All {posts.length}</button>
      {tags.map((t) => <button type="button" class="tf" data-t={t}>{t} {tagCount[t]}</button>)}
    </div>

    {years.map((y) => {
      const list = posts.filter((p) => p.date.startsWith(y));
      return (
        <section class="yr" data-year={y}>
          <div class="yl"><span class="label">{y}</span><span class="meta yc">{list.length}</span></div>
          <ol class="pl">
            {list.map((p) => (
              <li class="pi" data-s={(p.title + ' ' + p.tags.join(' ')).toLowerCase()} data-tags={p.tags.join('|')}>
                <a href={p.url}>
                  <h2>{p.title}</h2>
                  <p>{p.summary}</p>
                  <span class="meta">{p.date.slice(5)} &nbsp; {p.minutes} min &nbsp; {p.tags.join('  ')}{p.draft && <span class="dr">draft</span>}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );
    })}
  </main>
</Base>

<style>
  .bar { display: flex; justify-content: space-between; align-items: end; gap: 16px; }
  .search { display: flex; gap: 10px; align-items: center; border-bottom: 1px solid var(--line2); padding: 6px 0; width: min(320px, 100%); font: 400 0.8rem var(--mono); color: var(--accent); }
  .search input { flex: 1; background: none; border: 0; color: var(--ink); font: inherit; outline: none; }
  .tagrow { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 26px 0 40px; }
  .tf { background: none; border: 0; border-bottom: 1px solid transparent; padding: 2px 0; font: 400 0.74rem var(--mono); color: var(--soft); cursor: pointer; }
  .tf:hover { color: var(--ink); }
  .tf.on { color: var(--accent); border-bottom-color: var(--accent); }
  .yr { display: grid; grid-template-columns: 110px minmax(0, 640px); gap: 24px; border-top: 1px solid var(--line); padding-top: 22px; margin-bottom: 30px; }
  .yl { display: grid; align-content: start; gap: 2px; }
  .pl { list-style: none; margin: 0; padding: 0; }
  .pi + .pi { border-top: 1px solid var(--line); }
  .pi a { display: block; padding: 0 0 22px; text-decoration: none; }
  .pi + .pi a { padding-top: 22px; }
  .pi h2 { font-size: 1.32rem; line-height: 1.3; transition: color 0.2s; }
  .pi a:hover h2 { color: var(--accent); }
  .pi p { margin: 8px 0 10px; color: var(--soft); font-size: 0.95rem; line-height: 1.6; }
  .dr { margin-left: 12px; color: var(--lily); text-transform: uppercase; letter-spacing: 0.14em; }
  @media (max-width: 640px) { .yr { grid-template-columns: 1fr; gap: 10px; } }
</style>

<script is:inline>
(function () {
  var q = document.getElementById('q'), tag = '', items = [].slice.call(document.querySelectorAll('.pi'));
  function apply() {
    var s = q.value.trim().toLowerCase(), n = 0;
    items.forEach(function (li) {
      var ok = (!s || li.dataset.s.indexOf(s) > -1) && (!tag || li.dataset.tags.split('|').indexOf(tag) > -1);
      li.hidden = !ok; if (ok) n++;
    });
    document.querySelectorAll('.yr').forEach(function (y) {
      var vis = y.querySelectorAll('.pi:not([hidden])').length; y.hidden = !vis; y.querySelector('.yc').textContent = vis;
    });
    document.getElementById('count').textContent = n + ' / ' + items.length;
  }
  q.addEventListener('input', apply);
  document.getElementById('tags').addEventListener('click', function (e) {
    var b = e.target.closest('.tf'); if (!b) return; tag = b.dataset.t;
    this.querySelectorAll('.tf').forEach(function (x) { x.classList.toggle('on', x === b); }); apply();
  });
})();
</script>
